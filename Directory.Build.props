<Project>

    <!-- Shared settings for every project in the repo. Individual .csproj files can override any of these. -->
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Version>0.6.2.1</Version>
        <Authors>KSP2 Redux</Authors>
        <Company>KSP2 Redux</Company>
        <Product>KSP2 Redux</Product>
        <Copyright>Copyright © KSP2 Redux</Copyright>
        <NeutralLanguage>en</NeutralLanguage>
        <RepositoryUrl>https://github.com/KSP2Redux/Updater</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <!-- ImageSharp only decodes the CLI's embedded logo. Exclude its existing advisories while
         keeping audits enabled for other packages and newly reported vulnerabilities. -->
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Ksp2Redux.Tools.Cli' Or '$(MSBuildProjectName)' == 'Ksp2Redux.Tools.Launcher.Tests'">
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    </ItemGroup>

</Project>
