<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- netstandard2.1 so the Unity editor can load the same converter the launcher runs. -->
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyTitle>KSP2 Redux Bundle Conversion</AssemblyTitle>
        <Description>Retargets stock KSP2 bundle materials from embedded BRP shader copies to the Redux URP replacement shader bundles</Description>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AssetsTools.NET" />
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Text.Json" />
        <PackageReference Include="Testably.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\Ksp2Redux.Tools.Common\BannedSymbols.txt" Link="BannedSymbols.txt" />
    </ItemGroup>

    <!-- The Unity editor compiles Source as a local package (package.json, the asmdef and csc.rsp there).
         Source/Unity holds what it needs in place of Testably.Abstractions, System.Text.Json and implicit
         usings, so this build leaves it out. Json holds the System.Text.Json side, which Unity never sees. -->
    <ItemGroup>
        <Compile Remove="Source\Unity\**" />
        <None Remove="Source\**\*.meta" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ksp2Redux.Tools.BundleConversion.Tests" />
        <!-- The launcher's conversion service tests build their bundles with the same synthetic bundle helpers. -->
        <InternalsVisibleTo Include="Ksp2Redux.Tools.Launcher.Tests" />
    </ItemGroup>

</Project>
