<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:community="clr-namespace:Ksp2Redux.Tools.Launcher.ViewModels.Community"
             xmlns:launcher="clr-namespace:Ksp2Redux.Tools.Launcher"
             xmlns:controls="clr-namespace:Ksp2Redux.Tools.Launcher.Controls"
             xmlns:loc="using:Ksp2Redux.Tools.Launcher.Localization"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="530"
             x:Class="Ksp2Redux.Tools.Launcher.Views.Community.CommunityTabView"
             x:DataType="community:CommunityTabViewModel">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="GlassPanel" Classes="glass-panel" IsVisible="{Binding NewsVisible}">
            <!-- A reading column of about 70 characters a line. Left stretched rather than centred: a stretched
                 element limited by MaxWidth is centred anyway, while a centred one is sized to its content,
                 and the HTML panel reports the width of an earlier, wider layout, which clipped lines. -->
            <DockPanel Name="NewsDock" Margin="{StaticResource PanelInset}" MaxWidth="720"
                       DataContext="{Binding SelectedNews}" LastChildFill="True">
                <StackPanel Name="NewsHeader" DockPanel.Dock="Top" Spacing="4">
                    <TextBlock Classes="section-title" Text="{loc:T Community.Label}" />
                    <TextBlock FontSize="26" FontFamily="{StaticResource JetBrainsMonoBold}" LineHeight="34"
                               Text="{Binding Title}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Subtitle}" />
                        <Button Grid.Column="1" Classes="tonal" FontSize="11" Padding="10,4"
                                Content="{loc:T Community.ViewOnBlog}" ToolTip.Tip="{loc:T Community.ViewOnBlog.Tooltip}"
                                Click="NewsLink_OnClick" />
                    </Grid>
                    <!-- A hairline between the header and the article, 16 above and below. -->
                    <Border Margin="0,12,0,16" Height="1" Background="{StaticResource GlassSurfaceBorderBrush}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <controls:NewsHtmlPanel Name="Html" LinkClicked="Html_OnLinkClicked"
                                            BaseStylesheet="{x:Static launcher:App.NewsStylesheet}"
                                            Text="{Binding Content}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
