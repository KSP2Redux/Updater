<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:Ksp2Redux.Tools.Launcher.ViewModels.Settings"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:launcherConv="clr-namespace:Ksp2Redux.Tools.Launcher.Converters"
             xmlns:loc="using:Ksp2Redux.Tools.Launcher.Localization"
             x:DataType="settings:SettingsTabViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ksp2Redux.Tools.Launcher.Views.Settings.SettingsTabView"
             VerticalAlignment="Stretch">
	<UserControl.Styles>
		<Style Selector="NumericUpDown.chunk-download-spinner /template/ TextBox#PART_TextBox">
			<Setter Property="CornerRadius" Value="7,0,0,7" />
		</Style>
		<Style Selector="NumericUpDown.chunk-download-spinner /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton#PART_DecreaseButton /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="CornerRadius" Value="0,7,7,0" />
		</Style>
		<Style Selector="StackPanel.form">
			<Setter Property="Spacing" Value="10" />
		</Style>
		<Style Selector="TextBlock.section-title">
			<Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoLight}" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style Selector="Grid.field">
			<Setter Property="ColumnSpacing" Value="12" />
		</Style>
		<!-- TextBox height, so checkbox-only rows space out the same. -->
		<Style Selector="Grid.field > :is(Control)">
			<Setter Property="MinHeight" Value="32" />
		</Style>
		<Style Selector="Grid.field > TextBlock.label">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="MinHeight" Value="0" />
		</Style>
		<Style Selector="Grid.field > TextBlock.error">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,4,0,0" />
			<Setter Property="MinHeight" Value="0" />
		</Style>
		<Style Selector="Grid.field Button.icon, Grid.field Button.icon-text">
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Grid.field Button.icon">
			<Setter Property="Padding" Value="9,0" />
		</Style>
		<Style Selector="Grid.field Button PathIcon">
			<Setter Property="Width" Value="14" />
			<Setter Property="Height" Value="14" />
		</Style>
	</UserControl.Styles>

	<Grid VerticalAlignment="Stretch">
		<Border x:Name="GlassPanel" Margin="24,8,24,8"
		        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
		        Background="{StaticResource GlassSurfaceBrush}"
		        BorderBrush="{StaticResource GlassSurfaceBorderBrush}"
		        BoxShadow="{StaticResource GlassPanelShadow}"
		        BorderThickness="2" CornerRadius="{StaticResource RadiusLarge}">
		<ScrollViewer VerticalScrollBarVisibility="Auto"
		              HorizontalScrollBarVisibility="Disabled">
		<Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
			<TextBlock Grid.Row="0" FontFamily="{StaticResource JetBrainsMonoLight}"
			           FontSize="24" TextAlignment="Left" Margin="0,8,0,4"
			           Text="{loc:T Settings.Title}" />

			<Border Grid.Row="1" Margin="0,4,0,0" Padding="14"
			        BorderBrush="{StaticResource GlassSurfaceBorderBrush}" BorderThickness="1"
			        CornerRadius="{StaticResource RadiusMedium}">
				<!-- A Grid spends RowSpacing on hidden rows, a StackPanel does not. -->
				<StackPanel Classes="form" Grid.IsSharedSizeScope="True">
					<TextBlock Classes="section-title" Text="{loc:T Settings.Profile.Section}" />

					<Grid Classes="field" RowDefinitions="Auto,Auto">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Classes="label" Text="{loc:T Settings.Profile.Label}" />
						<Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
							<ComboBox HorizontalAlignment="Stretch"
							          MaxDropDownHeight="200"
							          IsVisible="{Binding !IsRenamingInstall}"
							          ItemsSource="{Binding Installs}"
							          SelectedItem="{Binding SelectedInstall, Mode=TwoWay}">
								<ComboBox.ItemTemplate>
									<DataTemplate DataType="settings:Ksp2InstallRowViewModel">
										<TextBlock Text="{Binding Name}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<TextBox Name="RenameBox" HorizontalAlignment="Stretch"
							         IsVisible="{Binding IsRenamingInstall}"
							         Text="{Binding RenameText, Mode=TwoWay}"
							         PlaceholderText="{loc:T Settings.Profile.NamePlaceholder}"
							         LostFocus="RenameBox_LostFocus" />
							<Button Grid.Column="1" Classes="icon"
							        IsVisible="{Binding !IsRenamingInstall}"
							        IsEnabled="{Binding HasSelectedInstall}"
							        Command="{Binding BeginRenameInstallCommand}"
							        ToolTip.Tip="{loc:T Settings.Profile.Rename.Tooltip}">
								<PathIcon Data="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z" />
							</Button>
							<Button Grid.Column="1" Classes="icon"
							        IsVisible="{Binding IsRenamingInstall}"
							        Command="{Binding CommitRenameInstallCommand}"
							        ToolTip.Tip="{loc:T Settings.Profile.RenameSave.Tooltip}">
								<PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" />
							</Button>
						</Grid>

						<!-- The negative bottom margin cancels the last line's button margin. -->
						<WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,-6">
							<Button Margin="0,0,6,6" Command="{Binding AddInstallCommand}" IsEnabled="{Binding !IsAddingInstall}"
							        Content="{loc:T Settings.Profile.Add}"
							        ToolTip.Tip="{loc:T Settings.Profile.Add.Tooltip}" />
							<Button Margin="0,0,6,6" Classes="danger"
							        Command="{Binding RemoveSelectedInstallCommand}"
							        IsEnabled="{Binding CanRemoveSelectedInstall}"
							        Content="{loc:T Settings.Profile.Remove}"
							        ToolTip.Tip="{loc:T Settings.Profile.Remove.Tooltip}" />
							<Button Margin="0,0,6,6" Command="{Binding OpenInstallFolderCommand}"
							        IsEnabled="{Binding HasSelectedInstall}"
							        Content="{loc:T Settings.Profile.OpenFolder}"
							        ToolTip.Tip="{loc:T Settings.Profile.OpenFolder.Tooltip}" />
							<!-- The tooltip explains the disabled state, so it must show while disabled. -->
							<Button Margin="0,0,6,6" Command="{Binding DownloadFromSteamCommand}"
							        IsEnabled="{Binding CanDownloadFromSteam}"
							        ToolTip.ShowOnDisabled="True"
							        Content="{loc:T Settings.Profile.DownloadKsp2}"
							        ToolTip.Tip="{Binding DownloadFromSteamTooltip}" />
						</WrapPanel>
					</Grid>

					<Separator Margin="0" IsVisible="{Binding HasSelectedInstall}" />

					<Grid Classes="field" RowDefinitions="Auto,Auto" IsVisible="{Binding HasSelectedInstall}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Classes="label" Text="{loc:T Settings.Exe.Label}" />
						<Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
							<TextBox HorizontalAlignment="Stretch"
							         Text="{Binding SelectedInstall.ExePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
							         PlaceholderText="C:\Steam\SteamGames\KSP2\KSP2_x64.exe" />
							<Button Grid.Column="1" Classes="icon-text"
							        Command="{Binding BrowseExePathCommand}"
							        ToolTip.Tip="{loc:T Settings.Exe.Browse.Tooltip}">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<PathIcon Data="M6.1,10L4,18V8H21A2,2 0 0,0 19,6H12L10,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H19C19.9,20 20.7,19.4 20.9,18.5L23.2,10H6.1M19,18H6L7.6,12H20.6L19,18Z" />
									<TextBlock VerticalAlignment="Center" Text="{loc:T Settings.Exe.Browse}" />
								</StackPanel>
							</Button>
						</Grid>
						<TextBlock Grid.Row="1" Grid.Column="1" Classes="error"
						           IsVisible="{Binding SelectedInstall.ExePathError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
						           Text="{Binding SelectedInstall.ExePathError}" />
					</Grid>

					<Grid Classes="field" IsVisible="{Binding HasSelectedInstall}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Classes="label" Text="{loc:T Settings.Channel.Label}" />
						<ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
						          Name="ReleaseChannelSelector"
						          MaxDropDownHeight="200"
						          SelectedValue="{Binding SelectedInstall.ReleaseChannel, Mode=TwoWay}"
						          ItemsSource="{Binding ValidChannels}">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="x:String">
									<TextBlock Text="{Binding Converter={x:Static launcherConv:ChannelConverters.DisplayName}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>

					<Grid Classes="field" IsVisible="{Binding ShowSteamLaunchOptions}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Classes="label"
						           Text="{loc:T Settings.LaunchViaSteam.Label}"
						           ToolTip.Tip="{loc:T Settings.LaunchViaSteam.Tooltip}" />
						<CheckBox Grid.Column="1" HorizontalAlignment="Left"
						          IsChecked="{Binding SelectedInstall.LaunchThroughSteam, Mode=TwoWay}" />
					</Grid>

					<Grid Classes="field" RowDefinitions="Auto,Auto" IsVisible="{Binding ShowSteamLaunchOptions}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Classes="label"
						           Text="{loc:T Settings.SteamAppId.Label}"
						           ToolTip.Tip="{loc:T Settings.SteamAppId.Tooltip}" />
						<TextBox Grid.Column="1" HorizontalAlignment="Stretch"
						         PlaceholderText="954850"
						         Text="{Binding SelectedInstall.SteamAppId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
						         IsEnabled="{Binding SelectedInstall.LaunchThroughSteam}" />
						<TextBlock Grid.Row="1" Grid.Column="1" Classes="error"
						           IsVisible="{Binding SelectedInstall.SteamAppIdError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
						           Text="{Binding SelectedInstall.SteamAppIdError}" />
					</Grid>

					<Grid Classes="field" IsVisible="{Binding HasSelectedInstall}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Classes="label"
						           Text="{loc:T Settings.LaunchArguments.Label}"
						           ToolTip.Tip="{loc:T Settings.LaunchArguments.Tooltip}" />
						<TextBox Grid.Column="1" HorizontalAlignment="Stretch"
						         Text="{Binding SelectedInstall.LaunchArguments, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
							<!-- Editable where Steam launching is unsupported, even if the config still ticks it. -->
							<TextBox.IsEnabled>
								<MultiBinding Converter="{x:Static BoolConverters.Or}">
									<Binding Path="!SelectedInstall.LaunchThroughSteam" />
									<Binding Path="!IsSteamLaunchSupported" />
								</MultiBinding>
							</TextBox.IsEnabled>
						</TextBox>
					</Grid>

					<Grid Classes="field" IsVisible="{Binding HasSelectedInstall}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Classes="label"
						           Text="{loc:T Settings.DisableGfxJobs.Label}"
						           ToolTip.Tip="{loc:T Settings.DisableGfxJobs.Tooltip}" />
						<CheckBox Grid.Column="1" HorizontalAlignment="Left"
						          IsChecked="{Binding SelectedInstall.DisableGraphicsJobs, Mode=TwoWay}" />
					</Grid>

					<Separator Margin="0" IsVisible="{Binding HasSelectedInstall}" />

					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"
					      IsVisible="{Binding HasSelectedInstall}">
						<Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
						        Click="InstallFromPatchFile"
						        Content="{loc:T Settings.InstallPatch.Button}"
						        ToolTip.Tip="{loc:T Settings.InstallPatch.Tooltip}" />
						<Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
						        Classes="danger" Click="UninstallReduxClick"
						        Content="{loc:T Settings.UninstallRedux.Button}"
						        ToolTip.Tip="{loc:T Settings.UninstallRedux.Tooltip}" />
						<Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
						        Classes="danger" Command="{Binding UninstallKsp2Command}"
						        IsEnabled="{Binding !IsUninstallingKsp2}"
						        Content="{Binding UninstallKsp2ButtonText}"
						        ToolTip.Tip="{loc:T Settings.UninstallKsp2.Tooltip}" />
					</Grid>
				</StackPanel>
			</Border>

			<Border Grid.Row="2" Margin="0,12,0,0" Padding="14"
			        BorderBrush="{StaticResource GlassSurfaceBorderBrush}" BorderThickness="1"
			        CornerRadius="{StaticResource RadiusMedium}">
				<StackPanel Classes="form">
					<TextBlock Classes="section-title" Text="{loc:T Settings.Advanced.Section}" />
					<Grid Classes="field" ColumnDefinitions="Auto,*,Auto,Auto">
						<TextBlock Grid.Column="0" Classes="label" Text="{loc:T Settings.PatchSource.Label}" />
						<ComboBox Grid.Column="1" MinWidth="120"
						          ItemsSource="{Binding PatchDownloadSources}"
						          SelectedItem="{Binding PatchDownloadSource, Mode=TwoWay}"
						          ToolTip.Tip="{loc:T Settings.PatchSource.Tooltip}" />
						<TextBlock Grid.Column="2" Classes="label" Text="{loc:T Settings.ConcurrentChunks.Label}" />
						<NumericUpDown Grid.Column="3" Classes="chunk-download-spinner"
						               Width="112" Minimum="1" Maximum="8" Increment="1"
						               Value="{Binding MaxConcurrentChunkDownloads, Mode=TwoWay}"
						               ToolTip.Tip="{loc:T Settings.ConcurrentChunks.Tooltip}" />
					</Grid>
				</StackPanel>
			</Border>

			<!-- Hidden until a translation ships, since English is the only choice before that. -->
			<Border Grid.Row="3" Margin="0,12,0,0" Padding="14"
			        BorderBrush="{StaticResource GlassSurfaceBorderBrush}" BorderThickness="1"
			        CornerRadius="{StaticResource RadiusMedium}"
			        IsVisible="{Binding ShowLanguagePicker}">
				<Grid Classes="field" ColumnDefinitions="Auto,*">
					<TextBlock Grid.Column="0" Classes="label" Text="{loc:T Settings.Language.Label}" />
					<ComboBox Grid.Column="1" MinWidth="200" HorizontalAlignment="Left"
					          MaxDropDownHeight="200"
					          ItemsSource="{Binding LanguageChoices}"
					          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="loc:LanguageOption">
								<TextBlock Text="{Binding DisplayName}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</Grid>
			</Border>

			<Grid Grid.Row="4" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
				<WrapPanel Grid.Row="0" Orientation="Horizontal">
				<Button Margin="0,0,10,6" FontSize="11" Padding="8,4" Click="OpenLogsFolderClick"
				        Content="{loc:T Settings.OpenLogsFolder}" />
				<Button Margin="0,0,10,6" Name="OpenGameDataFolderButton" FontSize="11" Padding="8,4"
				        Command="{Binding OpenGameDataFolderCommand}"
				        Content="{loc:T Settings.OpenGameDataFolder}"
				        ToolTip.Tip="{loc:T Settings.OpenGameDataFolder.Tooltip}" />
				<Button Margin="0,0,10,6" FontSize="11" Padding="8,4" Click="CopyDiagnosticInfoClick"
				        Content="{loc:T Settings.CopyDiagnosticInfo}" />
				<CheckBox Margin="0,0,0,6" FontSize="11" VerticalAlignment="Center"
				          IsChecked="{Binding VerboseLogging, Mode=TwoWay}"
				          Content="{loc:T Settings.VerboseLogging}"
				          ToolTip.Tip="{loc:T Settings.VerboseLogging.Tooltip}" />
				<CheckBox Margin="16,0,0,6" FontSize="11" VerticalAlignment="Center"
				          IsChecked="{Binding ParallaxMotion, Mode=TwoWay}"
				          Content="{loc:T Settings.BackgroundMotion}"
				          ToolTip.Tip="{loc:T Settings.BackgroundMotion.Tooltip}" />
				</WrapPanel>
				<TextBlock Grid.Row="1" Margin="0,2,0,0"
				           FontFamily="{StaticResource JetBrainsMonoLight}" FontSize="11"
				           Foreground="{StaticResource TextFaintBrush}"
				           HorizontalAlignment="Right" VerticalAlignment="Center"
				           Text="{Binding LauncherVersionText}" />
			</Grid>
		</Grid>
		</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
